{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "custom/power",
    "clock",
    "hyprland/window"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "custom/vpn",
    "custom/mic",
    "custom/volume",
    "custom/gpu",
    "custom/cpu",
    "custom/memory",
    "tray"
  ],

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "hyprland/window": {
    "format": "  {}",
    "max-length": 60,
    "separate-outputs": true
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": false,
    "persistent-workspaces": {
      "HDMI-A-3": [1, 2, 3, 4, 5],
      "DP-3": [6, 7, 8, 9, 10]
    }
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "power menu",
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "return-type": "json",
    "interval": 3
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu.sh",
    "return-type": "json",
    "interval": 3
  },

  "custom/memory": {
    "exec": "~/.config/waybar/scripts/memory.sh",
    "return-type": "json",
    "interval": 5
  },

  "custom/volume": {
    "exec": "~/.config/waybar/scripts/volume.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
  },

  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/vpn.sh",
    "return-type": "json",
    "interval": 10
  },

  "tray": {
    "icon-size": 14,
    "spacing": 6
  }
}
