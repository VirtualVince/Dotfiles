{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": [
    "clock",
    "hyprland/window"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "tray"
  ],

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "hyprland/window": {
    "format": "  {}",
    "max-length": 60,
    "separate-outputs": true
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": false,
    "persistent-workspaces": {
      "HDMI-A-3": [1, 2, 3, 4, 5],
      "DP-3": [6, 7, 8, 9, 10]
    }
  },

  "cpu": {
    "format": "cpu {usage}%",
    "interval": 2,
    "tooltip": false
  },

  "memory": {
    "format": "ram {percentage}%",
    "interval": 3,
    "tooltip-format": "{used:.1f}G / {total:.1f}G"
  },

  "network": {
    "interface": "wlp0s20u10",
    "format-wifi": "{essid}",
    "format-ethernet": "eth",
    "format-disconnected": "offline",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "interval": 5
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{desc}"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 6
  }
}
